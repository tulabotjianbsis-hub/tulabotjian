// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  role         String   // OWNER, ADMIN, SUPERVISOR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  ingredientsUpdated Ingredient[]  @relation("IngredientUpdatedBy")
  ordersProcessed    Order[]       @relation("OrderProcessedBy")
  transactions       Transaction[] @relation("TransactionProcessedBy")
  inventoryLogs      InventoryLog[] @relation("InventoryLogRecordedBy")

  @@map("users")
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  category    String
  imageUrl    String?
  isArchived  Boolean  @default(false)
  promoPrice  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  ingredients MenuItemIngredient[]
  orderItems  OrderItem[]

  @@map("menu_items")
}

model MenuItemIngredient {
  id           String  @id @default(uuid())
  menuItemId   String
  ingredientId String
  quantity     Float
  unit         String

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("menu_item_ingredients")
}

model Ingredient {
  id        String   @id @default(uuid())
  name      String
  category  String
  stock     Float
  unit      String
  supplier  String?
  expiryDate DateTime?
  status    String   @default("GOOD") // GOOD, LOW, CRITICAL, EXPIRED
  updatedById String?
  updatedAt DateTime @updatedAt

  updatedBy    User?                @relation("IngredientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  menuItems    MenuItemIngredient[]
  logs         InventoryLog[]
  alerts       Alert[]

  @@map("ingredients")
}

model Order {
  id                  String   @id @default(uuid())
  orderNumber         Int      @unique
  type                String   // DINE_IN, TAKE_OUT
  status              String   @default("PENDING") // PENDING, PREPARING, READY, COMPLETED, CANCELLED
  totalAmount         Float
  qrToken             String?
  processedById       String?
  tableNumber         Int?
  specialInstructions String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  processedBy User?       @relation("OrderProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  items       OrderItem[]
  transaction Transaction?
  alerts      Alert[]

  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String
  menuItemId          String
  quantity            Int
  unitPrice           Float
  variation           String?
  specialInstructions String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

model Transaction {
  id              String  @id @default(uuid())
  orderId         String  @unique
  processedById   String?
  amountPaid      Float
  change          Float
  paymentMethod   String  // CASH, GCASH, CARD
  createdAt       DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id])
  processedBy User? @relation("TransactionProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model InventoryLog {
  id              String   @id @default(uuid())
  ingredientId    String
  type            String   // RECEIVE, CONSUME, WASTE, ADJUSTMENT
  quantityChanged Float
  reason          String?
  previousStock   Float
  newStock        Float
  recordedById    String?
  createdAt       DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("InventoryLogRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@map("inventory_logs")
}

model Alert {
  id           String   @id @default(uuid())
  type         String   // LOW_STOCK, CRITICAL_STOCK, EXPIRY_WARNING, EXPIRY_CRITICAL, ORDER_OVERDUE
  title        String
  description  String?
  severity     String   @default("info") // info, warning, critical
  ingredientId String?
  orderId      String?
  dismissed    Boolean  @default(false)
  dismissedAt  DateTime?
  dismissedBy  String?
  createdAt    DateTime @default(now())

  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("alerts")
}
